PORT = 3006
CDT_PDF_URL = < Direct Davivienda PDF URL >
CDT_CACHE_TTL_MS = < Optional in-memory cache TTL in ms. Default is 86400000 (1 day) >
CDT_FETCH_RETRIES = < Optional number of retries for PDF fetch (default 5) >
CDT_USER_AGENT = < Optional browser User-Agent used by Davivienda PDF fetch >
ALLOWED_ORIGINS = < Comma-separated list of allowed origins for CORS, e.g., http://localhost:4200, http://example.com >
